# CloudWise AI - Environment Configuration Example
PROJECT_NAME=CloudWise AI
ENVIRONMENT=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./cloudwise.db

# AWS Integration Credentials (Optional: Leave empty for high-fidelity simulation mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=

# AI Copilot Engine (local, gemini, openai)
AI_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=

# Vector Database
VECTOR_DB_PATH=./chroma_db

# Notification Webhooks (Optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
